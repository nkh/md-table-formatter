#!/usr/bin/env perl

use strict ; use warnings ;
use utf8 ;

use List::Util qw/sum/ ;

binmode(STDOUT, ':utf8') ;
binmode(STDIN, ':utf8') ;

# ----------------------------------------------------------------------------

my %styles = (
	0 =>
		{
		tl => '|', tr => '|', bl    => '|', br => '|',
		h  => '-', v  => '|', cross => '|',
		t  => '|', b  => '|', l     => '|', r  => '|'
		},
	1 => 
		{
		tl => '.', tr => '.', bl    => "'", br => "'",
		h  => '-', v  => '|', cross => '|',
		t  => '-', b  => '-', l     => '|', r  => '|'
		},
	2 =>
		{
		tl => '+', tr => '+', bl    => '+', br => '+',
		h  => '-', v  => '|', cross => '+',
		t  => '+', b  => '+', l     => '+', r  => '+'
		},
	3 =>
		{
		tl => '┌', tr => '┐', bl    => '└', br => '┘',
		h  => '─', v  => '│', cross => '┼',
		t  => '┬', b  => '┴', l     => '├', r  => '┤'
		},
	4 =>
		{
		tl => '╔', tr => '╗', bl    => '╚', br => '╝',
		h  => '═', v  => '║', cross => '╬',
		t  => '╦', b  => '╩', l     => '╠', r  => '╣'
		},
	5 => 
		{
		tl => ' ', tr => ' ', bl    => ' ', br => ' ',
		h  => ' ', v  => ' ', cross => ' ',
		t  => ' ', b  => ' ', l     => ' ', r  => ' '
		},
	6 => 
		{
		tl => ' ', tr => ' ', bl    => ' ', br => ' ',
		h  => '_', v  => ' ', cross => '_',
		t  => '_', b  => '_', l     => ' ', r  => ' '
		}
	) ;

# ----------------------------------------------------------------------------

main(@ARGV)  ;

# ----------------------------------------------------------------------------

sub main
{
my @args = @_  ;

my $style           = 0 ;
my $align_all       = 0 ;
my $no_top          = 0 ;
my $no_bottom       = 0 ;
my $no_sides        = 0 ;
my $from_TSV        = 0 ;
my $TSV_no_header   = 0 ;

my $max_table_width = 10_000 ; # Set a high value to avoid truncation
my $max_row_width   = 10_000 ;
my $check_width     = 0 ;

my $input_file ;

while (@args)
	{
	my $arg = shift @args ;
	
	if ($arg eq '-s' || $arg eq '--style')
		{
		$style = shift @args // 0 ;
		$style = int($style) ;
		$style = 0 if $style < 0 || $style > 6 ;
		}
	elsif ($arg eq '-a' || $arg eq '--align-all')
		{
		$align_all = 1 ;
		}
	elsif ($arg eq '-m' || $arg eq '--max-width')
		{
		$max_table_width = shift @args // 10_000 ;
		}
	elsif ($arg eq '-c' || $arg eq '--check-width')
		{
		$check_width = 1 ;
		}
	elsif ($arg eq '-r' || $arg eq '--max-row-width')
		{
		$max_row_width = shift @args // 10_000 ;
		}
	elsif ($arg eq '--no-top')
		{
		$no_top = 1 ;
		}
	elsif ($arg eq '--no-bottom')
		{
		$no_bottom = 1 ;
		}
	elsif ($arg eq '--no-sides')
		{
		$no_sides = 1 ;
		}
	elsif ($arg eq '--from-TSV')
		{
		$from_TSV = 1 ;
		}
	elsif ($arg eq '--TSV-no-header')
		{
		$TSV_no_header = 1 ;
		}
	elsif ($arg eq '-h' || $arg eq '--help')
		{
		print_help() ;
		exit 0 ;
		}
	elsif (!defined $input_file && $arg !~ /^-/)
		{
		$input_file = $arg ;
		}
	else
		{
		print_help() ;
		exit 1 ;
		}
	}

if ($style == 0)
	{
	$style     = 0 ;
	$no_top    = 1 ;
	$no_bottom = 1 ;
	}

my @lines ;
if (defined $input_file)
	{
	open(my $fh, '<:utf8', $input_file) or die "Cannot open file '$input_file': $!\n"  ;
	@lines = <$fh> ;
	close $fh ;
	chomp @lines ;
	}
else
	{
	@lines = <STDIN> ;
	chomp @lines ;
	}

@lines = from_TSV(\@lines, $TSV_no_header) if $from_TSV ;

my $max_exceeded = process_input($max_table_width, $max_row_width, $check_width, \@lines, $style, $align_all, $no_top, $no_bottom, $no_sides) ;

exit $max_exceeded ? 1 : 0 ;
}

# ----------------------------------------------------------------------------

sub print_help
{
print <<'HELP' ;
Usage: md-table-formatter.pl [OPTIONS] [FILE]

Formats markdown tables read from stdin or FILE and outputs to stdout.

Options:
  --style|s N          table style
                       0 = Markdown (default)
                       1 = Asciio
                       2 = ASCII (+, -, |)
                       3 = Light box-drawing (Unicode)
                       4 = Heavy box-drawing (Unicode)
                       5 = Minimal (spaces only)
                       6 = horizontal lines only

  --align-all|a        align columns across all tables in the document
  --max-width|m N      maximum table width
  --max-row-width|r N  maximum row width, prepends '@' to rows that are too long 
  --check-width|c      also output an errors on stderr
  --no-top             no top line
  --no-bottom          no bottom line
  --no-sides           no side lines
  --from-TSV           convert from TSV format to markdown table
  --TSV-no-header      do not treat the first line as a header when converting from TSV
  --help|h             show this help message

Arguments:
  FILE                 input file (reads from stdin if not specified)

Example:

  cat table.md | md-table-formatter.pl -s 2
  md-table-formatter.pl -s 1 --align-all table.md
HELP
}

# ----------------------------------------------------------------------------

sub from_TSV
{
my ($lines, $no_header) = @_ ;

my $is_header = 1 ;
my @lines ;

foreach my $line ( $lines->@* )
	{
	chomp( $line ) ;
	my @cols = split( /\t/, $line ) ;
	my $row = join( " | ", @cols ) ;
	push @lines, "| $row |\n"  ;
	
	if ( $is_header && !$no_header )
		{
		my $sep = join( " | ", map( "---", @cols ) ) ;
		push @lines, "| $sep |\n" ;
		$is_header = 0 ;
		}
	}

return @lines ;
}

# ----------------------------------------------------------------------------

sub process_input
{
my ($max_table_width, $max_row_width, $check_width, $lines, $style, $align_all, $no_top, $no_bottom, $no_sides) = @_ ;

my $i = 0 ;
my @tables ;
my @output_plan ;
my $accumulate_text ;

while ($i < @$lines)
	{
	if ($lines->[$i] =~ /^\s*\|/)
		{
		my $start_line = $i ;
		
		$accumulate_text = undef ;
		
		my @table_lines ;
		my $start = $i ;
		
		while ($i < @$lines && $lines->[$i] =~ /^\s*\|/)
			{
			push @table_lines, $lines->[$i] ;
			$i++ ;
			}
		
		my ($headers, $alignments, $rows) = parse_table(\@table_lines) ;
		
		if (@$headers > 0)
			{
			my $table_data = 
				{
				headers => $headers,
				alignments => $alignments,
				rows => $rows,
				} ;
			
			push @tables, $table_data ;
			push @output_plan, { type => 'table', table => $table_data, lines => \@table_lines, at_line => $start_line + 1 } ;
			}
		else
			{
			push @output_plan, { type => 'text', lines => \@table_lines, at_line => $start_line + 1 } ;
			} 
		}
	else
		{
		if($accumulate_text)
			{
			push $accumulate_text->@*, $lines->[$i] ;
			}
		else
			{
			$accumulate_text = [ $lines->[$i] ] ;
			push @output_plan, { type => 'text', lines => $accumulate_text, at_line => $i + 1 } ;
			}
		
		$i++ ;
		}
	}

# use Data::TreeDumper ;
# print DumpTree { tables => \@tables, output_plan => \@output_plan } , '', QUOTE_VALUES => 1 ;

my $max_exceeded = 0 ;

if ($align_all && @tables > 0)
	{
	my $global_max_cols = 0 ;
	for my $table (@tables)
		{
		my $max          = max_columns($table->{headers}, $table->{rows}) ;
		$global_max_cols = $max if $max > $global_max_cols ;
		}
	
	my @global_widths = (0) x $global_max_cols ;
	
	for my $table (@tables)
		{
		my $max_cols = max_columns($table->{headers}, $table->{rows}) ;
		my $widths   = calculate_widths($table->{headers}, $table->{rows}, $max_cols, $max_row_width, $no_sides, $styles{$style}) ;
		
		for (my $j = 0; $j < @$widths; $j++)
			{
			$global_widths[$j] = $widths->[$j] if $widths->[$j] > $global_widths[$j] ;
			}
		}
	
	for my $item (@output_plan)
		{
		if ($item->{type} eq 'table')
			{
			my $table = $item->{table} ;
			
			$max_exceeded += print_table
						(
						$item->{at_line},
						$table->{headers},
						$table->{alignments},
						$table->{rows},
						$item->{lines},
						\@global_widths,
						$max_table_width,
						$max_row_width,
						$check_width,
						$global_max_cols,
						$style,
						$no_top,
						$no_bottom,
						$no_sides,
						) ;
			}
		else
			{
			for my $line (@{$item->{lines}})
				{
				print $line . "\n"  ;
				}
			}
		}
	}
else
	{
	for my $item (@output_plan)
		{
		if ($item->{type} eq 'table')
			{
			my $table      = $item->{table} ;
			
			my $max_cols   = max_columns($table->{headers}, $table->{rows}) ;
			my $col_widths = calculate_widths($table->{headers}, $table->{rows}, $max_cols, $max_row_width, $no_sides, $styles{$style}) ;
			
			$max_exceeded += print_table
						(
						$item->{at_line},
						$table->{headers},
						$table->{alignments},
						$table->{rows},
						$item->{lines},
						$col_widths,
						$max_table_width,
						$max_row_width,
						$check_width,
						$max_cols,
						$style,
						$no_top,
						$no_bottom,
						$no_sides,
						) ;
			}
		else
			{
			for my $line (@{$item->{lines}})
				{
				print $line . "\n"  ;
				}
			}
		}
	}

return $max_exceeded ;
}

# ----------------------------------------------------------------------------

sub parse_table
{
my ($lines) = @_ ;

my (@headers, @alignments, @rows) ;
my $header_found = 0 ;

for my $line (@$lines)
	{
	$line =~ s/^\s+|\s+$//g ;
	
	if ($line =~ /^\|/)
		{
		my @cells = split(/\|/, $line) ;
		shift @cells ;
		
		@cells = map { s/^\s+|\s+$//gr } @cells ;
		@cells = map { s/^\s*\-+\s*$/---/r } @cells ;
		
		if (!$header_found && @headers == 0)
			{
			@headers = @cells ;
			}
		elsif (!$header_found && is_separator_row(\@cells))
			{
			@alignments   = parse_alignments(\@cells) ;
			$header_found = 1 ;
			push @rows, \@cells ;
			}
		else
			{
			push @rows, \@cells ;
			}
		}
	else
		{
		last if @headers > 0 ;
		}
	}

return (\@headers, \@alignments, \@rows) ;
}

# ----------------------------------------------------------------------------

sub is_separator_row
{
my ($cells) = @_ ;

for my $cell (@$cells)
	{
	return 0 unless $cell =~ /^\s*\-+\s*$/ ;
	}

return 1 ;
}

# ----------------------------------------------------------------------------

sub parse_alignments
{
my ($cells) = @_ ;
my @aligns ;
for my $cell (@$cells)
	{
	if ($cell =~ /^:-+:$/)
		{
		push @aligns, 'center' ;
		}
	elsif ($cell =~ /^-+:$/)
		{
		push @aligns, 'right' ;
		}
	else
		{
		push @aligns, 'left' ;
		}
	}

return @aligns ;
}

# ----------------------------------------------------------------------------

sub max_columns
{
my ($headers, $rows) = @_ ;
my $max = scalar @$headers ;

for my $row (@$rows)
	{
	my $count = scalar @$row ;
	$max      = $count if $count > $max ;
	}

return $max ;
}

# ----------------------------------------------------------------------------

sub calculate_widths
{
my ($headers, $rows, $max_cols, $max_row_width, $no_sides, $s) = @_ ;
my @widths = (0) x $max_cols ;

my $formatting = '' ;

if($no_sides)
	{
	$formatting = (' ' . $s->{v} . ' ') x ($max_cols - 1);
	}
else
	{
	$formatting = ($s->{v} . ' ' . (' ' . $s->{v} . ' ') x ($max_cols - 1))  . ' ' . $s->{v} ;
	}

my $formatting_length = length($formatting) ;

my $total_width = 0 ;

for (my $i = 0; $i < @$headers; $i++)
	{
	$widths[$i]   = length($headers->[$i]) ;
	$total_width += $widths[$i] ;
	}

$total_width += $formatting_length ;

# print "headers width: $total_width, formatting: $formatting_length, max: $max_row_width\n\n" ;

for my $row (@$rows)
	{
	my @row_widths = @widths ;
	my $row_total_width = 0 ;
	
	for (my $i = 0; $i < @$row; $i++)
		{
		my $len         = length($row->[$i]) ;
		$row_widths[$i] = $len > $widths[$i] ? $len : $widths[$i] ;
		
		$row_total_width += $row_widths[$i] ;
		}
	
	if($row_total_width + $formatting_length <= $max_row_width && $row_total_width + $formatting_length > $total_width)
		{
		# print "Changing row width: @$row\n" ;
		# print "new: $row_total_width + " , $formatting_length, "\n" ;
		# print "old widths: @widths\n" ;
		@widths = @row_widths ;
		# print "new widths: @widths\n\n" ;
		$total_width = $row_total_width + $formatting_length ;
		}
	else
		{
		# print "not changing row width: @$row\n" ;
		# print "new: $row_total_width + " , $formatting_length, "\n" ;
		# print "old widths: @widths\n" ;
		}
	}

return \@widths ;
}

# ----------------------------------------------------------------------------

sub print_table
{
my ($at_line, $headers, $alignments, $rows, $lines, $widths, $max_table_width, $max_row_width, $check_width, $max_cols, $style, $no_top, $no_bottom, $no_sides) = @_ ;

my $s = $styles{$style} ;

if ($no_sides)
	{
	$s->{tl} = '' ; $s->{tr} = '' ;
	$s->{l}  = '' ; $s->{r}  = '' ;
	$s->{bl} = '' ; $s->{br} = '' ;
	}

# print "column widths: @$widths\n" ;

my $table_width = sum(@$widths) ;
   $table_width += length($s->{bl}) + length($s->{br}) + (length($s->{b}) * (@$widths - 1)) ;

my $max_exceeded = 0 ;

if($table_width <= $max_table_width)
	{
	print_border('top', $widths, $s) unless $no_top ;
	$max_exceeded += print_row($at_line, $headers, $lines->[0], $widths, $alignments, $max_row_width, $check_width, $max_cols, $s, $no_sides) ;
	print_border('middle', $widths, $s) ;
	
	my $index = 2 ;
	shift @$rows ;
	
	for my $row (@$rows)
		{
		$max_exceeded += print_row($at_line + $index, $row, $lines->[$index], $widths, $alignments, $max_row_width, $check_width, $max_cols, $s, $no_sides) ;
		$index++ ;
		}
	
	print_border('bottom', $widths, $s) unless $no_bottom ;
	}
else
	{
	$max_exceeded = 1 ;
	
	for my $line ($lines->@*)
		{
		print $line . "\n"  ;
		}
	}

return $max_exceeded ;
}

# ----------------------------------------------------------------------------

sub print_border
{
my ($type, $widths, $s) = @_ ;
my @parts ;

for (my $i = 0; $i < @$widths; $i++)
	{
	# push @parts, $s->{h} x 3 . ' ' x ($widths->[$i] - 1) ; # no spaces between the horizontal dashes and the vertical bar
	push @parts, ' ' . $s->{h} x 3 . ' ' x ($widths->[$i] - 2) ;
	}

if ($type eq 'top')
	{
	print $s->{tl} . join($s->{t}, @parts) . $s->{tr} . "\n"  ;
	}
elsif ($type eq 'middle')
	{
	print $s->{l} . join($s->{cross}, @parts) . $s->{r} . "\n"  ;
	}
elsif ($type eq 'bottom')
	{
	print $s->{bl} . join($s->{b}, @parts) . $s->{br} . "\n"  ;
	}
}

# ----------------------------------------------------------------------------

sub print_row
{
my ($at_line, $cells, $line, $widths, $alignments, $max_row_width, $check_width, $max_cols, $s, $no_sides) = @_ ;

my (@formatted, @formatted_widths) ;
for (my $i = 0 ; $i < $max_cols ; $i++)
	{
	my $cell  = $i < @$cells ? $cells->[$i] : '' ;
	my $width = $widths->[$i] ;
	my $align = $i < @$alignments ? $alignments->[$i] : 'left' ;
	
	my $formatted = format_cell($cell, $width, $align) ;
	push @formatted, $formatted ;
	push @formatted_widths, length($formatted) ;
	}

my $row ;

if($no_sides)
	{
	$row = join(' ' . $s->{v} . ' ', @formatted) ;
	}
else
	{
	$row = $s->{v} . ' ' . join(' ' . $s->{v} . ' ', @formatted) . ' ' . $s->{v} ;
	}

if(length($row) > $max_row_width)
	{
	# print length($row) . ">" . $row . "\n"  ;
	print "@" . $row . "\n"  ;
	
	if($check_width)
		{
		print STDERR 
			  "{"
			. "\"line\": $at_line, "
			. "\"column_widths\": [" . join(', ', @$widths) . "], "
			. "\"cells_widths\" : [" . join(', ', @formatted_widths) . "]"
			."}\n"  ;
		
		return 1 ;
		}
	}
else
	{
	print $row. "\n"  ;
	}

return 0 ;
}

# ----------------------------------------------------------------------------

sub format_cell
{
my ($text, $width, $align) = @_ ;

if ($align eq 'center')
	{
	my $total_pad = $width - length($text) ;
	my $left_pad  = int($total_pad / 2) ;
	my $right_pad = $total_pad - $left_pad ;
	
	return ' ' x $left_pad . $text . ' ' x $right_pad ;
	}
elsif ($align eq 'right')
	{
	return sprintf("%${width}s", $text) ;
	}
else
	{
	return sprintf("%-${width}s", $text) ;
	}
}
